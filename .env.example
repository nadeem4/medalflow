# MedalFlow configuration.
#
# Copy to `.env` and fill in. Every variable is prefixed MEDALFLOW_; `__`
# descends into a settings group (MEDALFLOW_<GROUP>__<FIELD>).
#
# Secrets are NOT configured here. ODBC connection strings and data lake access
# keys are pulled from Azure Key Vault by name; only the Key Vault coordinates
# below live in the environment.


# ---------------------------------------------------------------------------
# Required -- settings will not construct without these four.
# ---------------------------------------------------------------------------

# Source ERP system. Also the data lake file system (container) name.
MEDALFLOW_SOURCE_SYSTEM=sap

# Data source environment. Isolates this deployment's data within the lake.
MEDALFLOW_DS_ENV=dev

# Short data source name. The single source of the table prefix (`fin_`) and
# the external data source names (`ds_fin_raw`, `ds_fin_proc`).
MEDALFLOW_NAME=fin

# Lake database holding external table metadata.
MEDALFLOW_COMPUTE__LAKE_DATABASE_NAME=lakedb


# ---------------------------------------------------------------------------
# Where your models live -- required before anything can be discovered.
# ---------------------------------------------------------------------------

# Python package holding your models. Each layer is a subpackage of it:
# `acme_warehouse.bronze`, `acme_warehouse.silver`, `acme_warehouse.gold`.
# Settings construct without it; discovery is where it is missed, and the error
# names this variable.
# MEDALFLOW_MODELS_PACKAGE=acme_warehouse

# Name one layer's package directly. Each overrides the derived path above, and
# either can stand alone if you only use that layer.
# MEDALFLOW_BRONZE_PACKAGE=acme_warehouse.landing
# MEDALFLOW_SILVER_PACKAGE=acme_warehouse.silver
# MEDALFLOW_GOLD_PACKAGE=acme_reporting.marts

# Derive bronze tables from a live INFORMATION_SCHEMA query instead of from the
# declared @bronze_metadata models in the bronze package. Off by default:
# introspection makes compiling a plan require a warehouse. Turning it on
# ignores the bronze package entirely.
# MEDALFLOW_BRONZE_INTROSPECTION=false


# ---------------------------------------------------------------------------
# Required for a real deployment -- omit only when running fully offline.
# ---------------------------------------------------------------------------

# Storage account holding the bronze/silver/gold data.
MEDALFLOW_DATALAKE__PROCESSED__ACCOUNT_NAME=myprocessedlake

# Key Vault holding the ODBC strings and lake access keys. Without it, every
# secret resolves to None and no warehouse connection can be opened.
MEDALFLOW_KEYVAULT__URL=https://my-vault.vault.azure.net/


# ---------------------------------------------------------------------------
# Optional -- shown with their defaults.
# ---------------------------------------------------------------------------

# Key Vault authentication. Leave all three unset to use managed identity /
# DefaultAzureCredential; set all three to use a service principal.
# MEDALFLOW_KEYVAULT__TENANT_ID=
# MEDALFLOW_KEYVAULT__CLIENT_ID=
# MEDALFLOW_KEYVAULT__CLIENT_SECRET=

# Storage account holding client configuration files (e.g. the stats CSV).
# Leave unset if this project reads no configuration from the internal lake.
# MEDALFLOW_DATALAKE__INTERNAL__ACCOUNT_NAME=

# Key Vault secret names to read credentials from.
# MEDALFLOW_COMPUTE__ETL_ODBC_SECRET_NAME=ETL-SERVER
# MEDALFLOW_COMPUTE__CONSUMPTION_ODBC_SECRET_NAME=CONSUMPTION-SERVER
# MEDALFLOW_DATALAKE__PROCESSED__ACCESS_KEY_SECRET_NAME=PROCESSED-ADLS-ACCOUNT-KEY
# MEDALFLOW_DATALAKE__INTERNAL__ACCESS_KEY_SECRET_NAME=INTERNAL-ADLS-ACCESS-KEY

# Data lake authentication: access_key or managed_identity.
# MEDALFLOW_DATALAKE__PROCESSED__AUTH_METHOD=access_key
# MEDALFLOW_DATALAKE__INTERNAL__AUTH_METHOD=access_key

# Application deployment environment (dev, qa, uat, prod, local, ...).
# MEDALFLOW_APP_ENV=dev

# Comma-separated silver model groups to discover. Silver only: a silver model
# whose `model=` is not listed here is skipped. Gold is not filtered by it.
# MEDALFLOW_CONFIGURED_MODELS=sales,purchase,inventory

# Feature flags.
# MEDALFLOW_FEATURES__CTE_STATS_ENABLED=true
# MEDALFLOW_FEATURES__SNAPSHOTS_ENABLED=false
# MEDALFLOW_FEATURES__GLOBAL_CACHE_ENABLED=true

# SQL connection pool.
# MEDALFLOW_COMPUTE__SQL_POOL_SIZE=20
# MEDALFLOW_COMPUTE__SQL_POOL_TIMEOUT=30
# MEDALFLOW_COMPUTE__SQL_MAX_OVERFLOW=10

# Override the derived external data source names.
# MEDALFLOW_COMPUTE__RAW_EXTERNAL_DATA_SOURCE_NAME_OVERRIDE=
# MEDALFLOW_COMPUTE__PROCESSED_EXTERNAL_DATA_SOURCE_NAME_OVERRIDE=

# Path to the statistics configuration CSV in the internal lake.
# MEDALFLOW_STATS__STATS_CSV_PATH=client_configuration/external_table_stats.csv

# Naming conventions. Every one of these is off unless set: MedalFlow adds
# nothing to your SQL that you have not asked for here.

# Filter soft-deleted rows out of every bronze source read. Unset, bronze
# reads its source tables whole.
# MEDALFLOW_CONVENTIONS__SOFT_DELETE__PREDICATE=IsDelete IS NULL
# MEDALFLOW_CONVENTIONS__SOFT_DELETE__EXEMPT_TABLE_SUFFIXES=["Metadata"]

# Lookup table behind @silver_metadata(filter=...) dimensions. All five are
# required together; without them a filter-based dimension raises.
# MEDALFLOW_CONVENTIONS__ENUM_TABLE__SCHEMA_NAME=bronze
# MEDALFLOW_CONVENTIONS__ENUM_TABLE__TABLE_NAME=Enumeration
# MEDALFLOW_CONVENTIONS__ENUM_TABLE__NAME_COLUMN=Enum
# MEDALFLOW_CONVENTIONS__ENUM_TABLE__VALUE_COLUMN=EnumValue
# MEDALFLOW_CONVENTIONS__ENUM_TABLE__VALUE_ID_COLUMN=EnumValueID

# Promote a staged detail table into silver, stripping the suffix from its
# name. Unset, a query lands where its decorator said it would.
# MEDALFLOW_CONVENTIONS__DETAIL_TABLES__TABLE_SUFFIX=Detail
# MEDALFLOW_CONVENTIONS__DETAIL_TABLES__SOURCE_SCHEMA=temp
# MEDALFLOW_CONVENTIONS__DETAIL_TABLES__TARGET_SCHEMA=silver

# NULL-filling rules for promoted detail tables, applied in order, first match
# wins. Empty (the default) means NULLs are left alone. `match` is one of
# exact, suffix, contains; `default` is inlined as written.
# MEDALFLOW_CONVENTIONS__NULL_HANDLING=[{"match":"suffix","columns":["KeyID","Key"],"default":"-1"},{"match":"suffix","columns":["Date"],"default":"'1900-01-01'"}]

# Use mock secrets instead of Azure Key Vault. Tests only.
# CTE_TEST_MODE is a deprecated alias for this variable.
# MEDALFLOW_TEST_MODE=false
