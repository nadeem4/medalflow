# Configuration for the example project. Copy to `.env` and run `python run.py`
# from this directory -- MedalFlow reads `.env` from the working directory.
#
# These five variables are everything this project needs, and nothing it does
# not. There is no Key Vault here, no storage account and no connection string,
# because compiling never opens one: the bronze models are declared in
# `models/bronze/`, so the whole plan is built from the source tree.
#
# Executing the plan is a different matter, and needs the deployment variables
# in the repository root's `.env.example`. See README.md.

# The system this data is ingested from. Also the data lake file system
# (container) name, lowercased.
MEDALFLOW_SOURCE_SYSTEM=d365

# Data source environment. Isolates this deployment's data within the lake.
MEDALFLOW_DS_ENV=dev

# Short data source name. The single source of the table prefix (`sales_`) and
# of the external data source names (`ds_sales_raw`, `ds_sales_proc`).
MEDALFLOW_NAME=sales

# Lake database holding external table metadata.
MEDALFLOW_COMPUTE__LAKE_DATABASE_NAME=lakedb

# The package holding this project's models. `models.bronze`, `models.silver`
# and `models.gold` are what discovery walks. Settings construct without it;
# discovery is where it is missed, and the error names this variable.
MEDALFLOW_MODELS_PACKAGE=models
